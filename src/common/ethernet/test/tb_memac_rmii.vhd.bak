--------------------------------------------------------------------------------
-- Test operation:
-- 1. Create random RMII traffic sequences.
-- 2. Drive each sequence into the RMII RX DUT, and also the comparison queue.
-- 3. Wire the RMII RX and TX DUT UMII interfaces back to back.
-- 4. Capture RMII traffic sequences from the RMII TX DUT.
-- 5. Compare them with the sequences in the comparison queue.
--------------------------------------------------------------------------------
-- queue package instance

library memac;
  use memac.memac_rx_rmii_pkg.rmii8_rx_t;

package memac_sim_queue_rmii8_rx_pkg is
  new memac.memac_sim_queue_pkg generic map(queue_item_t => rmii8_rx_t);

--------------------------------------------------------------------------------
-- testbench

library memac;
  context memac.memac_sim_rmii_ctx;

entity tb_memac_rmii is
  generic (
    FRAME_SETS         : positive := 10;   -- how many sets of frames to generate
    FRAMES_PER_SET_MAX : positive := 10;   -- maximum number of frames per set
    CRL_MIN            : positive := 1;    -- carrier loss period - minimum, dibits
    CRL_MAX            : positive := 100;  -- carrier loss period - maximum, dibits
    CRS_MIN            : positive := 1;    -- carrier sense period (before frame) - minimum, dibits
    CRS_MAX            : positive := 20;   -- carrier sense period (before frame) - maximum, dibits
    PRE_MIN            : positive := 1;    -- frame preamble - minimum, octets
    PRE_MAX            : positive := 20;   -- frame preamble - maximum, octets
    FRAME_MIN          : positive := 1;    -- minimum frame length, octets (less than 42 violates spec)
    FRAME_MAX          : natural  := 1522; -- maximum frame length, octets (aka MTU)
    IPG_MIN            : positive := 1;    -- inter packet gap - minimum, octets
    IPG_MAX            : positive := 100   -- inter packet gap - maximum, octets
  );
end entity tb_memac_rmii;

architecture sim of tb_memac_rmii is

  type rmii_rx_t is record
    crs_dv : std_logic;
    er     : std_logic;
    d      : std_logic_vector(1 downto 0);
  end record rmii_rx_t;

  constant VERBOSE : boolean := false;

  signal rst         : std_ulogic;
  signal clk         : std_ulogic;

  signal rmii_link   : std_ulogic;
  signal rmii_spd    : std_ulogic;
  signal rmii_clken  : std_ulogic;
  signal rmii_crs_dv : std_ulogic;
  signal rmii_er     : std_ulogic;
  signal rmii_d      : std_ulogic_vector(1 downto 0);

  signal dut_rmii8   : rmii8_rx_t;

  signal umii_clken : std_ulogic;
  signal umii_dv    : std_ulogic;
  signal umii_er    : std_ulogic;
  signal umii_d     : std_ulogic_vector(7 downto 0);

  shared variable xq : work.memac_sim_queue_rmii8_rx_pkg.queue_t; -- expected queue

begin

  --------------------------------------------------------------------------------
  -- basics

  rst <= '1', '0' after 100 ns;

  clk <= '0' when clk = 'U' else not clk after RMII_CLK_PERIOD/2;

  --------------------------------------------------------------------------------
  -- drive DUT RMII input
  -- TODO:
  -- random ER assertions
  -- CRS glitch
  -- false carrier event
  -- DV glitch
  -- DV negation at odd nybble

  P_SOURCE: process
    variable prng   : prng_t;
    variable rmii2  : rmii_rx_t;
    variable rmii8  : rmii8_rx_t;
    variable n      : natural;
    variable d      : std_ulogic_vector(7 downto 0);

    procedure debugmsg(s : string) is
    begin
      if VERBOSE then
        report s severity note;
      end if;
    end procedure debugmsg;

  procedure model_rmii_tx_clk is
    variable n : natural;
  begin
    n := 10 when rmii_spd = '0' else 10;
    for i in 1 to n loop
      wait until falling_edge(clk);
    end loop;
  end procedure model_rmii_tx_clk;

  procedure model_rmii_tx2(s : in rmii_rx_t) is
  begin
    rmii_crs_dv <= s.crs_dv;
    rmii_er     <= s.er;
    rmii_d      <= s.d;
    model_rmii_tx_clk;
  end procedure model_rmii_tx2;

  procedure model_rmii_tx2(s : in rmii_rx_t; n : in natural) is
  begin
    if n > 0 then
      for i in 1 to n loop
        model_rmii_tx2(s);
      end loop;
    end if;
  end procedure model_rmii_tx2;

  begin
    -- initialise
    xq.reset;
    prng.rand_seed(123, 456);
    wait until falling_edge(rst);
    wait until falling_edge(clk);

    -- timing permutations
    LOOP_SPEED: for test_speed in 0 to 1 loop                                   -- speed (10/100)
      LOOP_CRL: for test_crl in 1 to 5 loop                                     -- carrier loss period
        LOOP_LINK: for test_link in -5 to +5 loop                               -- rmii_link assertion relative to rmii_crs_dv
          LOOP_CRS: for test_crs in 0 to 5 loop                                 -- rmii_crs_dv assertion relative to premable
            LOOP_ACT: for test_act in 1 to 8 loop                               -- active period
              report "speed = " & to_string(test_speed) & "  " &
                      "crl = " & to_string(test_crl) & "  " &
                      "link = " & to_string(test_link) & "  " &
                      "crs = " & to_string(test_crs) & "  " &
                      "act = " & to_string(test_act)
                      severity note;
              -- initial conditions
              rmii_link   <= '0';
              rmii_spd    <= 'X';
              rmii_crs_dv <= '0';
              rmii_er     <= '0';
              rmii_d      <= (others => '0');
              -- period: carrier loss
              xq.enq(rmii8_rx_t'("0000", "0000", x"00"), test_crl mod 4);       -- queue whole octets
              report "enq crl" severity note;
              wait for test_crl * RMII_CLK_PERIOD;
              -- period: link up before crs_dv (if applicable)
              if test_link >= 0 then
                xq.enq(("0000", "0000", x"00"), test_crl mod 4);                -- queue whole octets
                report "enq link" severity note;
                rmii_link <= '1';
                rmii_spd  <= '1' when test_speed = 1 else '0';
                rmii_spd  <= '1';
                report "FORCING SPEED" severity note;
                wait for test_link * RMII_CLK_PERIOD;
              end if;
              -- period: carrier sense before preamble
              xq.enq(("0000", "0000", x"00"), test_crl mod 4);                  -- queue whole octets
              report "enq crs" severity note;
              rmii_crs_dv <= '1';
              wait for test_crs * RMII_CLK_PERIOD;
              -- period: activity (frame contents)
              for i in 0 to test_act-1 loop
                if i < 2 then
                  rmii2 := ('1', '0', "01");                                    -- 1st and 2nd dibit must be clean preamble
                else
                  d := prng.rand_slv(0,7,8);
                  rmii2.crs_dv := 'X' when i mod 2 = 0 else '1';                -- DV = 1, CRS = X
                  rmii2.er     := d(2);
                  rmii2.d      := d(1 downto 0);
                end if;
                if i = test_link then
                  rmii_link <= '1';
                  rmii_spd  <= '1' when test_speed = 1 else '0';
                  rmii_spd  <= '1';
                  report "FORCING SPEED" severity note;
                end if;
                report "i = " & to_string(i) & " rmii2 = " & to_string(rmii2.crs_dv) & " " & to_string(rmii2.er) & " " & to_string(rmii2.d) severity note;
                rmii8 := (others => (others => 'U')) when i mod 4 = 0;
                rmii8.crs_dv(i mod 4)                       := rmii2.crs_dv;
                rmii8.er(i mod 4)                           := rmii2.er;
                rmii8.d(1+(2*(i mod 4)) downto 2*(i mod 4)) := rmii2.d;
                if i mod 4 = 3 and test_link > 0 then
                  xq.enq(rmii8);
                  report "enq rmii8 = " & to_string(rmii8.crs_dv) & " " & to_string(rmii8.er) & " " & to_string(rmii8.d) severity note;
                end if;
                model_rmii_tx2(rmii2);
              end loop;
            end loop LOOP_ACT;
          end loop LOOP_CRS;
        end loop LOOP_LINK;
      end loop LOOP_CRL;
    end loop LOOP_SPEED;
    wait;
  end process P_SOURCE;

  --------------------------------------------------------------------------------
  -- check DUT RMII8 (internal) and UMII (output)

  P_CHECK: process(clk)
    variable tally : integer := 0;
  begin
    if rising_edge(clk) and umii_clken = '1' then
      if xq.items > 0 then
        if  xq.front.crs_dv = "0000"
        and xq.front.er     = "0000"
        and xq.front.d      = "X0X0X0X0"
        then
          report "FINISHED" severity note;
          std.env.stop;
        end if;
      end if;
      if  dut_rmii8.crs_dv = "0000"
      and dut_rmii8.er     = "0000"
      and dut_rmii8.d      = x"00"
      then -- received gap
        -- dequeue any expected gaps
        while xq.items > 0 loop
          if  xq.front.crs_dv = "0000"
          and xq.front.er     = "0000"
          and xq.front.d      = x"00"
          then
            xq.deq;
          end if;
        end loop;
      else -- received activity
        -- dequeue any expected gaps
        while xq.items > 0 loop
          if  xq.front.crs_dv = "0000"
          and xq.front.er     = "0000"
          and xq.front.d      = x"00"
          then
            xq.deq;
          end if;
        end loop;
        if xq.items = 0 then
          -- nothing to compare against
          report "nothing to compare against:" & LF &
            "  dv  = " & to_string( dut_rmii8.crs_dv ) & LF &
            "  er  = " & to_string( dut_rmii8.er     ) & LF &
            "  d   = " & to_string( dut_rmii8.d      )
            severity failure;
        else
          -- check received against expected
          if dut_rmii8.crs_dv /= xq.front.crs_dv
          or dut_rmii8.er     /= xq.front.er
          or dut_rmii8.d      /= xq.front.d
          then
            report "mismatch" & LF &
              "  got: " & LF &
              "    dv  = " & to_string( dut_rmii8.crs_dv ) & LF &
              "    er  = " & to_string( dut_rmii8.er     ) & LF &
              "    d   = " & to_string( dut_rmii8.d      ) & LF &
              "  exp: " & LF &
              "    dv  = " & to_string( xq.front.crs_dv ) & LF &
              "    er  = " & to_string( xq.front.er     ) & LF &
              "    d   = " & to_string( xq.front.d      ) & LF &
              "  tally = " & to_string(tally)
              severity failure;
          end if;
        end if;
        tally := tally + 1;
        xq.deq;
        report "******************** tally = " & to_string(tally) severity note;
      end if;
    end if;
  end process P_CHECK;

  --------------------------------------------------------------------------------
  -- DUT

  DUT_CLK: component memac_rmii_clken
    port map (
      rst           => rst,
      clk           => clk,
      rmii_spd      => rmii_spd,
      rmii_clken    => rmii_clken,
      umii_tx_clken => open
    );

  DUT: component memac_rx_rmii
    port map (
      rst         => rst,
      clk         => clk,
      rmii_link   => rmii_link,
      rmii_clken  => rmii_clken,
      rmii_crs_dv => rmii_crs_dv,
      rmii_er     => rmii_er,
      rmii_d      => rmii_d,
      umii_clken  => umii_clken,
      umii_dv     => umii_dv,
      umii_er     => umii_er,
      umii_d      => umii_d
    );

  dut_rmii8 <= << signal DUT.rmii8 : rmii8_rx_t >>;

  --------------------------------------------------------------------------------

end architecture sim;
